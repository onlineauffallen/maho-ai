# Zugang zum Sprachmodell. Nie einchecken, nie im Chat weitergeben.
OPENAI_API_KEY=

# Zugelassene Zugangscodes, kommagetrennt. Ohne diese Zeile steht der Endpunkt
# offen, das ist nur in der Entwicklung vertretbar.
MAHO_ZUGANG=beta-eins,beta-zwei

# Erlaubte Herkünfte für Browseraufrufe, kommagetrennt.
MAHO_ALLOWED_ORIGIN=http://localhost:8080

# Modelle. Ohne Angabe: gpt-5.6-terra für den Chat, gpt-5.6-luna fürs Gedächtnis.
# MAHO_MODEL=
# MAHO_MEMORY_MODEL=

# Tagesbudget in gewichteten Token (Eingabe 1, Ausgabe 4, zwischengespeichert 0,1),
# je Zugangscode und insgesamt. Ohne Angabe 400000 und 3000000.
# MAHO_TAGESBUDGET=
# MAHO_TAGESBUDGET_GESAMT=
